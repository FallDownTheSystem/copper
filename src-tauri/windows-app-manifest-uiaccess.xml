<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The release manifest. Identical to tauri-build's stock manifest except for the
  trustInfo block, which is the whole point of it.

  uiAccess="true" is what lets Copper read a selection out of a window running
  elevated — an administrator PowerShell, a code editor started as administrator.
  Windows activates it only when both conditions hold: the binary carries a valid
  Authenticode signature chaining to a certificate in the machine's trust stores,
  and it runs from a secure location (%ProgramFiles%, which the per-machine NSIS
  install provides).

  The level stays asInvoker. uiAccess is not elevation and must not be confused
  with it: Copper still runs as the logged-in user at medium integrity, and asking
  for requireAdministrator here would put a UAC prompt in front of every launch.

  This file is applied by build.rs only when COPPER_UIACCESS is set and the
  profile is release. It is deliberately NOT the default, because an unsigned
  binary that declares uiAccess="true" does not merely lose the capability — it
  refuses to start, with CreateProcess error 740 (ERROR_ELEVATION_REQUIRED) and no
  window to explain itself. Dev builds are unsigned by definition, so they take
  tauri-build's stock manifest and have no trustInfo block at all.

  The Common-Controls dependency is carried over verbatim from tauri-build's
  default. Dropping it would take v6 common controls away from the dialog plugin's
  file pickers, which is a regression that would only show up as ugly dialogs.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="true" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
