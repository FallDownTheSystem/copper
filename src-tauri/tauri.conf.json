{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Copper",
	"identifier": "io.github.falldownthesystem.copper",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:1420",
		"beforeDevCommand": "vp dev",
		"beforeBuildCommand": "vp run build",
		"removeUnusedCommands": true
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Copper",
				"width": 390,
				"height": 660,
				"resizable": false,
				"decorations": false,
				"transparent": true,
				"alwaysOnTop": true,
				"skipTaskbar": true,
				"visible": false,
				"focus": false,
				"maximizable": false,
				"minimizable": false,
				"closable": false,
				"center": true,
				"shadow": true,
				"dragDropEnabled": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"publisher": "FallDownTheSystem",
		"copyright": "© 2026 FallDownTheSystem",
		"shortDescription": "Capture panel for notes and prompts",
		"createUpdaterArtifacts": true,
		"fileAssociations": [
			{
				"ext": ["copper"],
				"name": "Copper.Space",
				"description": "Copper Project"
			}
		],
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
		"windows": {
			"webviewInstallMode": {
				"type": "downloadBootstrapper",
				"silent": true
			},
			"digestAlgorithm": "sha256",
			"timestampUrl": "http://timestamp.digicert.com",
			"nsis": {
				"installMode": "perMachine",
				"languages": ["English"],
				"displayLanguageSelector": false,
				"installerIcon": "icons/icon.ico",
				"uninstallerIcon": "icons/icon.ico"
			}
		}
	},
	"plugins": {
		"updater": {
			"endpoints": [
				"https://github.com/FallDownTheSystem/copper/releases/latest/download/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1MTk3RkQ5ODgxQ0M4NTAKUldSUXlCeUkyWDhaTlVqbGdaWUZ5NmVjVTFIYks1RTV0aVJvcUNSNlIrQWJhN2tDa1VVZlVBMDgK",
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
