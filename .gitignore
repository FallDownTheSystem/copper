# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Tauri
src-tauri/target/
src-tauri/gen/
# The copper-cli sidecar staged for bundle.externalBin by
# scripts/build-copper-cli.mjs — a build artifact, same category as target/.
src-tauri/binaries/

# Updater signing key — never commit the private half
*.key
!*.pub.key

# Authenticode certificate material: the private half of the self-signed
# code-signing certificate, in either export format. It lives outside the repo
# (see backlog/docs/doc-release-process.md); these patterns exist so a stray
# export dropped in the tree cannot be staged by accident.
*.pfx
*.p12

# The release-only Tauri config override. It carries `certificateThumbprint`,
# which identifies a certificate in one machine's store and means nothing in any
# other checkout, so it is supplied per machine rather than committed.
src-tauri/tauri.release.conf.json

# Project management artifacts
backlog/

# Claude Code per-user settings. The shared .claude/settings.json may be
# committed; the .local. one is personal and must not be.
.claude/settings.local.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# dotenv environment variable files
.env
.env.*
!.env.example
